define                  = 
integrator              = md
dt                      = 0.002
nsteps                  = 2500000
cutoff-scheme           = Verlet
nstlist                 = 20
rlist                   = 1.2
vdwtype                 = Cut-off
vdw-modifier            = Force-switch
rvdw_switch             = 1.0
rvdw                    = 1.2
coulombtype             = PME
rcoulomb                = 1.2
constraints             = h-bonds
constraint_algorithm    = LINCS
tcoupl                  = v-rescale
tc_grps                 = SOLU MEMB SOLV
tau_t                   = 1.0 1.0 1.0
ref_t                   = 303.15 303.15 303.15
pcoupl                  = c-rescale
pcoupltype              = semiisotropic
tau_p                   = 5.0
compressibility         = 4.5e-5  4.5e-5
ref_p                   = 1.0     1.0
nstcomm                 = 100
comm_mode               = linear
comm_grps               = SOLU_MEMB SOLV
nstxout-compressed      = 5000
nstenergy               = 1000
nstlog                  = 1000
gen-vel                 = no
gen-temp                = 303.15
gen-seed                = 20260726
continuation            = yes
