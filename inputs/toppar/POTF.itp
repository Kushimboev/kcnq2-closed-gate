;; Filter K+ as separate moleculetype so the 2 inserted ions can be position-restrained
;; independently (POSRES_FC_ION) during staged re-equilibration. Identical physics to POT.
[ moleculetype ]
; name	nrexcl
POTF	     1

[ atoms ]
; nr	type	resnr	residu	atom	cgnr	charge	mass
     1        POT      1     POTF    POT      1     1.000000    39.0983   ; qtot 1.000

#ifdef POSRES
[ position_restraints ]
; ai  funct  fcx           fcy           fcz
   1     1   POSRES_FC_ION POSRES_FC_ION POSRES_FC_ION
#endif
